    "auto_prioritize_queries": true,
    "browser_profile_dir": "./browser_profile/linkedin",
    "chrome_executable": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "connection_outreach": {
      "account_tier": "standard",
      "agency_search_queries": [
        "\"Technical Recruiter\" Tech India",
        "\"IT Recruiter\" Tech India",
        "\"Staffing Specialist\" Tech India"
      ],
      "daily_limit": 10,
      "enabled": true,
      "hard_network_cap": 30000,
      "max_per_company": 1,
      "min_acceptance_rate_warning": 0.3,
